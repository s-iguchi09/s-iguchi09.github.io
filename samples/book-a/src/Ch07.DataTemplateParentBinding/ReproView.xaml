<!--
  再現版。テンプレートの中で {Binding Unit} と {Binding DeleteCommand} と書いている。
  テンプレートの中の DataContext は行の項目に切り替わるため、どちらも親のビューモデルに届かない。
  単位は空のまま、削除ボタンは有効に見えるのに、押しても何も起きない（Command が null で、IsEnabled は True のまま）。
-->
<UserControl x:Class="Ch07.DataTemplateParentBinding.ReproView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ch07.DataTemplateParentBinding"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=local:MeasurementListViewModel}"
             mc:Ignorable="d">
  <ItemsControl x:Name="list" ItemsSource="{Binding Items}" Margin="8">
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <StackPanel Orientation="Horizontal" Margin="0,2">
          <TextBlock Text="{Binding Name}" Width="30" />
          <TextBlock Text="{Binding Value}" Width="40" TextAlignment="Right" />
          <TextBlock x:Name="unitText" Width="30" Margin="4,0,0,0"
                     Text="{Binding Unit}" />
          <Button x:Name="deleteButton" Content="削除" Padding="8,0"
                  Command="{Binding DeleteCommand}"
                  CommandParameter="{Binding}" />
        </StackPanel>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
