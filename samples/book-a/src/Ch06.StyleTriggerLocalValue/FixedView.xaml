<!--
  修正版。背景の既定値を Border のローカル値ではなく、スタイルの Setter に置く。再現版との違いはこの 1 か所だけである。
  Setter はトリガーより優先順位が低いため、HasError が true の間はトリガーの背景が効く。
-->
<UserControl x:Class="Ch06.StyleTriggerLocalValue.FixedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ch06.StyleTriggerLocalValue"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=local:StatusViewModel}"
             mc:Ignorable="d">
  <StackPanel Margin="8">
    <StackPanel.Resources>
      <Style x:Key="StatusBox" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#9AA4B2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18,6" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding HasError}" Value="True">
            <Setter Property="Background" Value="#FFD4D4" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </StackPanel.Resources>

    <Border x:Name="statusBox" Style="{StaticResource StatusBox}">
      <TextBlock Text="{Binding HasError, StringFormat='HasError = {0}'}" />
    </Border>
    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
      <Button Content="エラーにする" Command="{Binding ShowErrorCommand}" Padding="8,2" />
      <Button Content="エラーを消す" Command="{Binding ClearErrorCommand}" Padding="8,2" Margin="8,0,0,0" />
    </StackPanel>
  </StackPanel>
</UserControl>
