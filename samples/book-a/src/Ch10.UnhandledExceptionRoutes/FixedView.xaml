<!--
  修正版。ビューは再現版と同じで、違いはビューモデル（await して try / catch で受ける）だけである。
  「取り込む」を押すと、失敗の理由が赤い文字で出る。
-->
<UserControl x:Class="Ch10.UnhandledExceptionRoutes.FixedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ch10.UnhandledExceptionRoutes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=local:ImportViewModel}"
             mc:Ignorable="d">
  <StackPanel Margin="8">
    <Button x:Name="importButton" Content="取り込む" Command="{Binding StartImportCommand}" Padding="12,2" HorizontalAlignment="Left" />
    <TextBlock x:Name="errorText" Text="{Binding ErrorMessage}" Foreground="#D13438" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
