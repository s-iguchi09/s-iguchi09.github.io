<!--
  修正版。見本の枠の背景を DynamicResource で参照する。再現版との違いはこの 1 か所だけである。
  DynamicResource はエントリの差し替えを追いかけるので、「テーマを切り替える」で枠の色が変わる。
-->
<UserControl x:Class="Ch09.StaticResourceNotUpdating.FixedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ch09.StaticResourceNotUpdating"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=local:ThemeViewModel}"
             mc:Ignorable="d">
  <!-- テーマの状態はビューモデルの IsDark。リソースの差し替えは添付プロパティ ThemeResources.IsDark が行う。 -->
  <StackPanel x:Name="themeRoot" Margin="8" local:ThemeResources.IsDark="{Binding IsDark}">
    <StackPanel.Resources>
      <SolidColorBrush x:Key="ThemeColor" Color="SkyBlue" />
    </StackPanel.Resources>

    <Border x:Name="sample" Background="{DynamicResource ThemeColor}" Height="40" BorderBrush="Gray" BorderThickness="1">
      <TextBlock Text="見本" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <Button Content="テーマを切り替える" Command="{Binding ToggleThemeCommand}" Padding="8,2" Margin="0,8,0,0" HorizontalAlignment="Left" />
  </StackPanel>
</UserControl>
