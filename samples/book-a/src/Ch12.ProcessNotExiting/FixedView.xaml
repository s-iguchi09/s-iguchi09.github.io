<!--
  修正版。ビューは再現版と同じで、違いはビューモデル（スレッドに IsBackground = true を立てる）だけである。
  ウィンドウを閉じると、監視の途中でもプロセスはすぐ終わる。
-->
<UserControl x:Class="Ch12.ProcessNotExiting.FixedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ch12.ProcessNotExiting"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=local:MonitorViewModel}"
             mc:Ignorable="d">
  <StackPanel Margin="8" Orientation="Horizontal">
    <Button x:Name="startButton" Content="監視を始める" Command="{Binding StartMonitoringCommand}" Padding="12,2" />
    <TextBlock Text="{Binding Status}" Margin="8,0,0,0" VerticalAlignment="Center" />
  </StackPanel>
</UserControl>
