<!--
  修正版のカード。UserControl の直下の Grid だけ、DataContext をカード自身に向ける。
  中のバインドは {Binding Title} のまま書け、利用側からのバインド（カード要素の DataContext）は壊さない。
  Title は既定で双方向にバインドされるよう登録してあるので、中の TextBox で編集した値が利用側のビューモデルへ戻る。
-->
<UserControl x:Class="Ch08.UserControlDependencyProperty.FixedInfoCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ch08.UserControlDependencyProperty">
  <Border BorderBrush="Gray" BorderThickness="1" Padding="6">
    <Grid x:Name="cardRoot" DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:FixedInfoCard}}}">
      <StackPanel>
        <TextBlock x:Name="titleText" Text="{Binding Title}" />
        <TextBox x:Name="titleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="180" HorizontalAlignment="Left" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
