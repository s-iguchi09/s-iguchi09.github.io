<!--
  修正版。ユーザーが変える値のバインドに Mode=TwoWay を書く。再現版との違いはこの 2 か所だけである。
  展開ボタンやキーで開いた状態、GridSplitter で変えた幅がビューモデルへ渡り、
  「すべて閉じる」「幅を戻す」にも画面が従う。
-->
<UserControl x:Class="Ch01.BindingModeOmitted.FixedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ch01.BindingModeOmitted"
             d:DataContext="{d:DesignInstance Type=local:FolderBrowserViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <TextBlock Text="{Binding Folders[0].IsExpanded, StringFormat='ビューモデルの Documents.IsExpanded: {0}'}" />
      <TextBlock Text="{Binding NavigationWidth, StringFormat='ビューモデルの NavigationWidth: {0}'}" />
      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
        <Button x:Name="collapseAllButton" Content="すべて閉じる" Command="{Binding CollapseAllCommand}" Padding="8,2" />
        <Button x:Name="resetWidthButton" Content="幅を戻す" Command="{Binding ResetWidthCommand}" Padding="8,2" Margin="8,0,0,0" />
      </StackPanel>
    </StackPanel>

    <Grid x:Name="layoutGrid">
      <Grid.ColumnDefinitions>
        <!-- 修正: Mode=TwoWay を書く。GridSplitter で変えた幅がビューモデルへ渡る。 -->
        <ColumnDefinition x:Name="navigationColumn" Width="{Binding NavigationWidth, Mode=TwoWay}" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>

      <TreeView x:Name="folderTree" ItemsSource="{Binding Folders}">
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem">
            <!-- 修正: Mode=TwoWay を書く。展開ボタン・→ キー・ダブルクリックのどれで開いてもビューモデルへ渡る。 -->
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.ItemTemplate>
          <HierarchicalDataTemplate ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" />
          </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

      <!-- 既定の Right では調整される列の組み合わせが変わるため、Center にする。 -->
      <GridSplitter x:Name="splitter" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

      <TextBlock Grid.Column="2" Margin="8,0,0,0" TextWrapping="Wrap"
                 Text="展開ボタンでノードを開くか、仕切りをドラッグしてから、下のボタンを押す。" />
    </Grid>
  </DockPanel>
</UserControl>
