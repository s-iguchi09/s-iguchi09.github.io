<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- PrintWindow でウィンドウを PNG 化するために System.Drawing を使う。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScreenshotCapture</AssemblyName>
    <RootNamespace>ScreenshotCapture</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms が入れる暗黙 using は、WPF の型（TextBox・Brush など）と
         名前が衝突する。System.Drawing は Capture.cs だけで明示的に using する。 -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- 付録サンプルのビューモデルを MVVM ライブラリで書いた場合の検証（Scenes/BookA/BookALibrariesScene.cs）。
         Prism は MIT ライセンスの最後の版に固定する。 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Prism.Core" Version="8.1.97" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本の付録サンプル（samples/book-a）を、記事の計測と同じ実入力で検証する（Scenes/BookA/）。 -->
    <ProjectReference Include="..\..\samples\book-a\src\Ch01.BindingModeOmitted\Ch01.BindingModeOmitted.csproj" />
    <ProjectReference Include="..\..\samples\book-a\src\Ch02.InputLimits\Ch02.InputLimits.csproj" />
    <ProjectReference Include="..\..\samples\book-a\src\Ch03.DataGridCommitOnSave\Ch03.DataGridCommitOnSave.csproj" />
    <ProjectReference Include="..\..\samples\book-a\src\Ch04.CanExecuteNotUpdating\Ch04.CanExecuteNotUpdating.csproj" />
    <ProjectReference Include="..\..\samples\book-a\src\Ch05.ValidationNotDisplayed\Ch05.ValidationNotDisplayed.csproj" />
    <ProjectReference Include="..\..\samples\book-a\src\Ch06.StyleTriggerLocalValue\Ch06.StyleTriggerLocalValue.csproj" />
    <ProjectReference Include="..\..\samples\book-a\src\Ch07.DataTemplateParentBinding\Ch07.DataTemplateParentBinding.csproj" />
    <ProjectReference Include="..\..\samples\book-a\src\Ch08.UserControlDependencyProperty\Ch08.UserControlDependencyProperty.csproj" />
    <ProjectReference Include="..\..\samples\book-a\src\Ch09.StaticResourceNotUpdating\Ch09.StaticResourceNotUpdating.csproj" />
    <ProjectReference Include="..\..\samples\book-a\src\Ch10.UnhandledExceptionRoutes\Ch10.UnhandledExceptionRoutes.csproj" />
    <ProjectReference Include="..\..\samples\book-a\src\Ch11.TaskResultDeadlock\Ch11.TaskResultDeadlock.csproj" />
    <ProjectReference Include="..\..\samples\book-a\src\Ch12.ProcessNotExiting\Ch12.ProcessNotExiting.csproj" />
  </ItemGroup>

</Project>
