# Jekyll のローカルビルド生成物
_site/
.jekyll-cache/
.jekyll-metadata

# .NET のビルド生成物（tools/ 配下のキャプチャツール）
bin/
obj/

# Python のバイトコードキャッシュ（.github/scripts 配下のスクリプト実行時に生成される）
__pycache__/
*.py[cod]

# Node の依存（tools/og-image の画像生成スクリプト）
node_modules/

# Claude Code が作る入れ子の worktree（git add -A でコミットに入らないようにする）
.claude/worktrees/

# Claude Code の個人用の設定（コミットしない。承認する内容にも入らないようにする）
.claude/settings.local.json
